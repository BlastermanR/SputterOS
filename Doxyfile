# ────────────────────────────────────────────────────────────────────────────
# Doxyfile — SputterOS API Documentation Configuration
# ────────────────────────────────────────────────────────────────────────────
# Usage:
#   make docs            Generate HTML + call/dependency graphs
#   doxygen Doxyfile     Run directly
#
# Requires: doxygen, graphviz (dot)
# Output:   docs/api/html/index.html
# ────────────────────────────────────────────────────────────────────────────

# ── Project Metadata ─────────────────────────────────────────────────────────
PROJECT_NAME           = "SputterOS"
PROJECT_NUMBER         = 0.5.0
PROJECT_BRIEF          = "Deterministic C++17 control framework for nanofab systems"
PROJECT_LOGO           =
OUTPUT_DIRECTORY       = docs/api

# ── Input Sources ────────────────────────────────────────────────────────────
INPUT                  = include/sputteros \
                         src
FILE_PATTERNS          = *.h *.cpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */lib/* */tests/* */_deps/*

# ── Extraction ───────────────────────────────────────────────────────────────
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES
EXTRACT_LOCAL_CLASSES  = YES

# ── Source Browsing ──────────────────────────────────────────────────────────
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
STRIP_CODE_COMMENTS    = NO

# ── Preprocessing ────────────────────────────────────────────────────────────
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
PREDEFINED             = SPUTTEROS_ASSERT(expr)=

# ── HTML Output ──────────────────────────────────────────────────────────────
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_DYNAMIC_SECTIONS  = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO

# ── LaTeX / Other Outputs (disabled) ────────────────────────────────────────
GENERATE_LATEX         = NO
GENERATE_RTF           = NO
GENERATE_MAN           = NO
GENERATE_XML           = NO

# ── Graphviz Diagrams ────────────────────────────────────────────────────────
HAVE_DOT               = YES
DOT_PATH               =
CLASS_DIAGRAMS         = YES
CLASS_GRAPH            = YES
COLLABORATION_GRAPH    = YES
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
CALL_GRAPH             = YES
CALLER_GRAPH           = YES
GRAPHICAL_HIERARCHY    = YES
DIRECTORY_GRAPH        = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_MULTI_TARGETS      = YES

# ── Warnings ─────────────────────────────────────────────────────────────────
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = NO
WARN_FORMAT            = "$file:$line: warning: $text"

# ── Miscellaneous ────────────────────────────────────────────────────────────
SORT_MEMBER_DOCS       = YES
SORT_BRIEF_DOCS        = YES
GENERATE_TODOLIST      = YES
GENERATE_BUGLIST       = YES
SHOW_USED_FILES        = YES
SHOW_FILES             = YES
SHOW_NAMESPACES        = YES
BUILTIN_STL_SUPPORT    = YES
